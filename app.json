{
  "expo": {
    "name": "Attendly",
    "slug": "attendance-demo",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.devorify.attendly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.devorify.attendly"
    },
    "extra": {
      "eas": {
        "projectId": "65fbf81d-606a-4b61-8d6e-78a1b8405f81"
      }
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "blockblaze"
  }
}
